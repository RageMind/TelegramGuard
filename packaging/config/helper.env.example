# TelegramGuard privileged helper configuration
# Managed mode is provisioned automatically by the installer when a safe SSH bootstrap IP is detected.
FIREWALL_MODE=observe
FIREWALL_STATE=/var/lib/telegram-guard-helper/firewall.json
SSH_PORT=22
NFT_FAMILY=inet
NFT_TABLE=telegram_guard
NFT_IPV4_SET=trusted_ipv4
NFT_IPV6_SET=trusted_ipv6
MANAGED_SERVICES=ssh.service
SSH_JOURNAL_UNIT=ssh.service
HELPER_SOCKET=/run/telegram-guard/helper.sock
HELPER_SOCKET_GROUP=telegram-guard
HELPER_ALLOWED_USER=telegram-guard
