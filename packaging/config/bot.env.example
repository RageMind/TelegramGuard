# TelegramGuard bot configuration
# Copy to /etc/telegram-guard/bot.env and replace placeholders locally.
TELEGRAM_BOT_TOKEN=REPLACE_WITH_BOT_TOKEN
TELEGRAM_ADMIN_IDS=REPLACE_WITH_NUMERIC_TELEGRAM_USER_ID
TELEGRAM_POLL_TIMEOUT=25
RATE_LIMIT_PER_MINUTE=20
ALERT_INTERVAL_SECONDS=60
SSH_FAILED_ALERT_THRESHOLD=10
SSH_APPROVAL_ENABLED=false
SSH_APPROVAL_SOCKET=/run/telegram-guard-bot/approval.sock
SSH_APPROVAL_TIMEOUT=75
STATE_DB=/var/lib/telegram-guard/state.sqlite3
HELPER_SOCKET=/run/telegram-guard/helper.sock
